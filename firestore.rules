rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin(){ return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /encuestas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['colonia','pasaCamion','frecuencia','tiempoSinPasar','horario','satisfaccion','acumulacionBasura','problemaPrincipal','mejoras','comentario','fechaRegistro'])
        && request.resource.data.colonia is string && request.resource.data.colonia.size() > 0 && request.resource.data.colonia.size() < 120
        && request.resource.data.pasaCamion in ['Sí','No','Algunas veces']
        && request.resource.data.mejoras is string && request.resource.data.mejoras.size() > 0 && request.resource.data.mejoras.size() <= 800
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 800
        && request.resource.data.fechaRegistro == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    match /resumen/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() || request.resource.data.total == 1;
      allow update: if isAdmin() || (request.resource.data.total == resource.data.total + 1 && request.resource.data.keys().size() < 14);
      allow delete: if isAdmin();
    }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; }
  }
}
